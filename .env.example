# Server-side Postgres connection (Supabase > Project Settings > Database).
# Used by the query layer and by the db:push / seed / verify scripts.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Only set for a disposable demo project. Reset commands also require
# --confirm-demo-reset and refuse NODE_ENV=production.
AUTUMN_DEMO_PROJECT_REF=

# Supabase project (Project Settings > API). Not used by the query layer —
# it speaks SQL directly — but kept for client-side Supabase features.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
