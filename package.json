{
  "name": "autumn-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test src/components/**/*.test.mjs src/lib/*.test.mjs scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "db:push": "node --env-file=.env.local node_modules/.bin/tsx scripts/db-push.ts",
    "db:secure": "node --env-file=.env.local node_modules/.bin/tsx scripts/secure-database.ts",
    "seed": "node --env-file=.env.local node_modules/.bin/tsx scripts/seed.ts",
    "verify": "node --env-file=.env.local node_modules/.bin/tsx scripts/verify-seed.ts && node --env-file=.env.local node_modules/.bin/tsx scripts/verify-backend.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
